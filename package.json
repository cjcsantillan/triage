{
  "name": "triage",
  "version": "1.0.0",
  "private": true,
  "description": "Reads a support ticket and returns urgency, category, and a drafted reply using an Amazon Bedrock language model. Ships as a web app and a CLI.",
  "type": "module",
  "bin": {
    "triage": "./dist/cli/triage-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/public dist/public",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "cli": "tsx src/cli/triage-cli.ts",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.632.0",
    "@aws-sdk/credential-providers": "^3.632.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
